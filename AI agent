import random
# 1. The Activation Function (Decides if the neuron "fires" or not)
def step_function(sum_value):
    if sum_value >= 0:
        return 1
    else:
        return 0

def main():
    # 2. The Environment (Training Data for Logical OR)
    # Inputs: {0,0}, {0,1}, {1,0}, {1,1}
    inputs = [[0, 0], [0, 1], [1, 0], [1, 1]]
    # Expected Outputs: 0, 1, 1, 1
    expected_outputs = [0, 1, 1, 1]

    # 3. The Agent's "Brain" (Weights and Bias)
    weights = [random.random(), random.random()]
    bias = random.random()
    learning_rate = 0.1
    epochs = 20 # Number of times it will study the data

    print("Training the AI Agent to learn Logical OR...")
    print(f"Initial Weights: w1={weights[0]:.2f}, w2={weights[1]:.2f}, bias={bias:.2f}\n")

    # 4. The Learning Loop
    for epoch in range(epochs):
        total_error = 0
        
        for i in range(len(inputs)):
            # Agent makes a guess based on current weights
            sum_value = (inputs[i][0] * weights[0]) + (inputs[i][1] * weights[1]) + bias
            prediction = step_function(sum_value)

            # Calculate how wrong the agent was
            error = expected_outputs[i] - prediction
            total_error += abs(error)

            # Agent updates its brain to do better next time
            weights[0] += learning_rate * error * inputs[i][0]
            weights[1] += learning_rate * error * inputs[i][1]
            bias += learning_rate * error
        
        # If there are no errors, the agent has learned the pattern!
        if total_error == 0:
            print(f"Agent successfully learned the pattern at epoch {epoch + 1}!")
            break

    # 5. Testing the Agent
    print("\n--- Testing the Trained Agent ---")
    for i in range(len(inputs)):
        sum_value = (inputs[i][0] * weights[0]) + (inputs[i][1] * weights[1]) + bias
        prediction = step_function(sum_value)
        print(f"Input: ({inputs[i][0]}, {inputs[i][1]}) -> AI Prediction: {prediction}")

if __name__ == "__main__":
    main()
